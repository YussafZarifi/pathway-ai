# Copy to frontend/.env.local for local development (git-ignored).
# On Render, set VITE_API_URL in the static site's Environment instead.
# Vite reads it at build time, so changing it needs a rebuild.

# Required: base URL of the PathwayAI backend, no trailing slash.
# Local dev (uvicorn main:app --port 8000):
VITE_API_URL=http://127.0.0.1:8000
# Production example: VITE_API_URL=https://pathwayai-api.onrender.com

# Optional: Supabase accounts (ADR-018). Both values are public by design
# (Supabase Dashboard > Project Settings > API Keys: the "publishable" key,
# sb_publishable_...). Never put the secret / service_role key here: every
# VITE_ variable is shipped to the browser. Leave both empty to run without
# accounts; the quiz, results and dashboard work the same either way.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Example: VITE_SUPABASE_URL=https://<project-ref>.supabase.co
