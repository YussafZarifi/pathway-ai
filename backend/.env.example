# Copy to backend/.env and fill in. Never commit backend/.env.

# Required: Google AI Studio key for Gemini (career matches + roadmaps).
GEMINI_API_KEY=

# Optional: YouTube Data API v3 key for real videos on each roadmap step.
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
# Without it, each step shows a "Search YouTube" link instead.
# Free quota: 10,000 units/day; each step search costs 100 (about 20 roadmaps/day).
YOUTUBE_API_KEY=
