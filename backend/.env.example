# Copy to backend/.env and fill in. Never commit backend/.env.
# On Render, set these in the backend service's Environment instead.

# Required: Google AI Studio key for Gemini (career matches + roadmaps).
# Without it the AI endpoints return 503.
GEMINI_API_KEY=

# Optional: YouTube Data API v3 key for real videos on each roadmap step.
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
# Without it, each step shows a "Search YouTube" link instead.
# Free quota: 10,000 units/day; each step search costs 100 (about 20 roadmaps/day).
YOUTUBE_API_KEY=

# Required: comma-separated frontend origins allowed to call the API (CORS).
# No trailing slash. Local dev with Vite:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: ALLOWED_ORIGINS=https://pathwayai-web.onrender.com

# Optional: Gemini model and per-request timeout.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Optional: AI endpoint rate limits (in memory, per server instance).
# Per client IP, per minute and per day; plus one global cap per day.
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=50
GLOBAL_AI_LIMIT_PER_DAY=500

# Optional: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Client IP forwarding for IP-based rate limits. Locally, keep "none" so
# caller-supplied forwarding headers are ignored. Render sets "render" in
# render.yaml and uses CF-Connecting-IP. Other hosts may use "cidrs" with
# explicit trusted proxy networks below.
TRUSTED_PROXY_MODE=none
TRUSTED_PROXY_CIDRS=

# Optional: expose Swagger, ReDoc and the OpenAPI schema for local development.
# Keep false in production; true exposes the API route schema publicly.
API_DOCS_ENABLED=true

# Optional: Supabase project URL for accounts (ADR-018), no trailing slash.
# The API verifies users' access tokens against this project's public keys
# (JWKS). No Supabase secret is needed. Leave empty to run without accounts
# (GET /api/me returns 503; the AI routes work the same).
SUPABASE_URL=
# Example: SUPABASE_URL=https://<project-ref>.supabase.co

# Optional: Postgres connection for saved roadmaps (Milestone 2, ADR-019).
# SECRET: contains the password of the least-privilege pathwayai_api role.
# Use Supabase's transaction pooler (Dashboard -> Connect -> Transaction
# pooler, port 6543) with the role name as <role>.<project-ref>:
#   postgresql://pathwayai_api.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# Never the postgres/service_role credentials. Leave empty to run without
# saved roadmaps (/api/roadmaps* return 503; guests work the same).
DATABASE_URL=
# Optional: maximum pooled connections from this server (default 5).
DB_POOL_MAX=5

# Résumé analysis (Milestone 3, ADR-020). Keep false unless GEMINI_API_KEY
# belongs to a paid (billing-enabled) Google project: the unpaid tier's
# terms forbid sending personal information such as résumés. While false,
# POST /api/resume-analyses returns 503 before reading any upload. Also
# needs SUPABASE_URL and DATABASE_URL (signed-in users only).
RESUME_ANALYSIS_ENABLED=false
# Optional: per-user and global limits for résumé analyses (defaults 3, 10, 100).
RESUME_LIMIT_PER_HOUR=3
RESUME_LIMIT_PER_DAY=10
RESUME_GLOBAL_LIMIT_PER_DAY=100

# RAG coaching retrieval implementation. LangChain is the production default;
# set to "native" only to use the equivalent in-house retrieval implementation.
RAG_RETRIEVER=langchain
RAG_COACHING_ENABLED=true
# Coaching is optional enrichment and uses a short request budget after the
# deterministic analysis has been saved.
RAG_COACHING_TIMEOUT_SECONDS=5
# Semantic retrieval stays behind the provider-neutral embedding interface.
RAG_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional: check AI-suggested resource links before showing a roadmap and
# drop clearly broken ones (link_check.py: public HTTPS only, SSRF-safe).
# Default true; set false where the server has no outbound internet.
LINK_CHECK_ENABLED=true

# AI Coach (Milestone 4, ADR-021): signed-in chat about the roadmap. On by
# default; set false to switch it off (each message is one Gemini request).
# Needs SUPABASE_URL and DATABASE_URL.
COACH_ENABLED=true
# Optional: per-user and global limits for coach messages (defaults 20, 60, 300).
COACH_LIMIT_PER_HOUR=20
COACH_LIMIT_PER_DAY=60
COACH_GLOBAL_LIMIT_PER_DAY=300
