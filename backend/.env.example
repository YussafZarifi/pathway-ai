# Copy to backend/.env and fill in. Never commit backend/.env.
# On Render, set these in the backend service's Environment instead.

# Required: Google AI Studio key for Gemini (career matches + roadmaps).
GEMINI_API_KEY=

# Optional: YouTube Data API v3 key for real videos on each roadmap step.
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
# Without it, each step shows a "Search YouTube" link instead.
# Free quota: 10,000 units/day; each step search costs 100 (about 20 roadmaps/day).
YOUTUBE_API_KEY=

# Required: comma-separated frontend origins allowed to call the API (CORS).
# No trailing slash. Local dev with Vite:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: ALLOWED_ORIGINS=https://pathwayai-web.onrender.com

# Optional: Gemini model.
GEMINI_MODEL=gemini-2.5-flash-lite
